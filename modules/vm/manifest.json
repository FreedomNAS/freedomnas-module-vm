  "depends_on": [],
  "webui": {
    "api_routes": "api_routes.py",
    "route_prefix": "/api/vm",
    "router_attr": "router",
    "templates_dir": "frontend/templates",
    "static_dir": "frontend/static",
    "page_route": "/vm/",
    "page_template": "vm.html",
    "nav": {
      "label": "Virtual machines",
      "icon": "icons.svg#vm",
      "level": "advanced"
    }
  }
